# Local Runtime WebSocket endpoint. The first release is localhost-only.
VITE_RUNTIME_WS_URL=ws://127.0.0.1:8765/ws

# Temporary v1 compatibility alias; remove after the one-release migration window.
# VITE_HERMES_WS_URL=ws://127.0.0.1:8765/ws

RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=8765
RUNTIME_LOG_DIR=.runtime-data/logs
RUNTIME_CONTENT_LOGGING=false
RUNTIME_SEMANTIC_SAMPLE_RATE=0.005
RUNTIME_SEMANTIC_SAMPLE_DAILY_CAP=50
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
QWEN_ASR_MODEL_REVISION=7278e1e70fe206f11671096ffdd38061171dd6e5
QWEN_ASR_GPU_MEMORY_UTILIZATION=0.88
RUNTIME_VAD_BACKEND=silero
RUNTIME_ASR_BACKEND=qwen
QWEN_SUPERVISOR_MODEL=Qwen/Qwen3-1.7B
QWEN_SUPERVISOR_MODEL_REVISION=70d244cc86ccca08cf5af4e1e306ecf908b1ad5e
RUNTIME_SUPERVISOR_BACKEND=deterministic
RUNTIME_SUPERVISOR_QUANTIZATION=nf4
RUNTIME_SUPERVISOR_DEVICE=cuda
RUNTIME_SUPERVISOR_MODEL_PATH=/opt/livechat-agent/models/qwen3-supervisor-nf4
RUNTIME_HERMES_BACKEND=disabled
RUNTIME_TTS_BACKEND=kokoro-loopback
# start-local.ps1 discovers the current Windows WSL virtual-interface address.
RUNTIME_TTS_ENDPOINT=http://172.17.176.1:8771
# Deployment intentionally reserves the GPU for Qwen ASR; Kokoro runs on CPU.
RUNTIME_TTS_CHUNK_DELAY_MS=90
KOKORO_TTS_MODEL=hexgrad/Kokoro-82M-v1.1-zh
KOKORO_TTS_MODEL_REVISION=01e7505bd6a7a2ac4975463114c3a7650a9f7218
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
QWEN_TTS_MODEL_REVISION=85e237c12c027371202489a0ec509ded67b5e4b5
HERMES_TIMEOUT_SECONDS=30
HERMES_RETRY_BUDGET=1
HERMES_SESSION_BUDGET=4
