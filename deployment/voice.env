RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=8765
RUNTIME_VAD_BACKEND=silero
RUNTIME_ASR_BACKEND=qwen
QWEN_ASR_GPU_MEMORY_UTILIZATION=0.88
RUNTIME_SUPERVISOR_BACKEND=deterministic
RUNTIME_HERMES_BACKEND=disabled
RUNTIME_TTS_BACKEND=kokoro-loopback
RUNTIME_TTS_ENDPOINT=${RUNTIME_TTS_ENDPOINT:?RUNTIME_TTS_ENDPOINT must be set by start-local.ps1}
# Each payload contains 100 ms of PCM. A 90 ms cadence keeps a small lead
# without overflowing the browser's bounded two-second playback buffer.
RUNTIME_TTS_CHUNK_DELAY_MS=90
PYTORCH_ALLOC_CONF=expandable_segments:True
