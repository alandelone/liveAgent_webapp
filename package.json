{
  "name": "livechat_agent",
  "private": true,
  "version": "0.2.0",
  "engines": {
    "node": ">=24.19.0",
    "npm": ">=11.17.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "python server.py",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:runtime": "python -m unittest discover -s runtime/tests -v",
    "test:fixtures": "python scripts/generate-fixtures.py --check",
    "test:all": "npm run test && npm run test:runtime && npm run test:fixtures",
    "lint": "tsc --noEmit",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@types/node": "24.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "6.1.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "30.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.14",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
